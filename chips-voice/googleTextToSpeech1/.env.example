# Copy to .env or set these in the systemd unit. Everything is optional unless marked required.

# --- Playback ---
PLAYER=liquidsoap               # liquidsoap (server) or vlc (desktop with MIDI ducking)
LIQUIDSOAP_PORT=1234
MUSIC_DIR=/srv/music
PREEMPT_LIVE=false              # true: announcements interrupt a live DJ by default

# --- Login (required with PLAYER=liquidsoap; need these or API_KEY) ---
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=            # npm run hash-password
SESSION_SECRET=                 # openssl rand -hex 32
API_KEY=                        # optional, for scripts
# Optional Neon Auth: also accept its session JWTs (the login above keeps working).
# NEON_AUTH_URL=https://ep-xxx.neonauth.example.neon.tech/neondb/auth   # from the Neon console
# NEON_AUTH_ISSUER=                 # optional: require this iss claim
CORS_ORIGIN=https://your-site.netlify.app

# --- Speech (comma list = fallback order) ---
TTS_PROVIDER=google             # google | openai | elevenlabs | piper
GOOGLE_APPLICATION_CREDENTIALS=/etc/chipsvoice/tts-creds.json
# OPENAI_API_KEY=  OPENAI_TTS_MODEL=tts-1  OPENAI_TTS_VOICE=alloy
# ELEVENLABS_API_KEY=  ELEVENLABS_MODEL=eleven_v3  ELEVENLABS_STABILITY=0.5
# ELEVENLABS_VOICES="Rocky=<voice id>,Britta=<voice id>"   # names shown in the UI; used by dialogue
# OPENROUTER_TTS_MODEL=<speech model id>  OPENROUTER_TTS_VOICES=alloy,nova   # needs OPENROUTER_API_KEY (below)
# TTS_PROVIDER takes a list, for example elevenlabs,openrouter,google
# PIPER_BIN=piper  PIPER_MODELS=/opt/piper/en_US-lessac-medium.onnx

# --- AI drafting (leave LLM_PROVIDER empty to turn it off; comma list = fallback order) ---
LLM_PROVIDER=openrouter         # openrouter | anthropic | openai | ollama
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_FALLBACK_MODELS=anthropic/claude-3.5-haiku,meta-llama/llama-3.1-8b-instruct
# OPENROUTER_REFERER=https://your-site.netlify.app  OPENROUTER_TITLE=Chips Voice
# ANTHROPIC_API_KEY=  ANTHROPIC_MODEL=
# OPENAI_LLM_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1  OLLAMA_MODEL=llama3

# --- Audio hand-off from another system (VirtuaHost on Netlify) ---
# INGEST_TOKEN=                 # openssl rand -hex 32; lets the sender deliver audio and nothing else
# INGEST_MAX_MB=25
# INGEST_ALLOWED_HOSTS=your-site.netlify.app   # hosts /ingest/url may fetch (https only)
# INGEST_TRANSCODE=true         # convert WAV/Ogg to MP3 with ffmpeg (needs ffmpeg installed)
# MAX_DIALOGUE_CHARS=10000

# --- Virtual host (server-side copy of krap-station/host/virtual_host.py; off until enabled in the UI) ---
# HOST_VOICE=Rocky  HOST_FX=underground  HOST_EVERY=1  HOST_LINES=template   # or llm
# HOST_SKIP_ARTISTS="syndicate empire radio,way high radio,k.r.a.p. relay"
# HOST_PERSONA=       # extra instructions for AI-written links; STATION_NAME names the station for them
# FFMPEG_BIN=ffmpeg   # effects, dialogue joining and MP3 conversion need ffmpeg

# --- Clip library and links ---
DATA_DIR=/var/lib/chipsvoice    # library.json (clips, schedules)
# Optional Neon Postgres: when set, clips and schedules are stored there instead of library.json.
# DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/neondb?sslmode=require
CLIPS_DIR=/srv/clips
CLIP_CACHE_MB=300               # least recently played non-favorites are deleted beyond this
PUBLIC_URL=https://api.example.com   # base for audio stream links
STREAM_SECRET=                  # signs audio links; defaults to SESSION_SECRET
MAX_TEXT_CHARS=500
RATE_LIMIT_PER_MIN=30           # per client, for speech and AI calls

# --- Hub and multi-station use (docs/HUB.md) ---
# STATION_NAME=Ship Radio        # shown in the hub (also names the station for AI-written host links)
# PLAYLIST_DIR=/var/lib/chipsvoice/playlists   # playlists pushed by the hub, selectable as "list:<name>"
# MUSIC_DIR=/srv/music           # the library the hub can see and build playlists from
# The site's Voice Lab tab reaches this server through its own proxy (VOICE_URL + VOICE_KEY = this server's address and API_KEY), so CORS is only needed for browsers that call it directly

# --- Cloud sharing: Google Drive (and other rclone remotes) ---
# STORAGE_RCLONE_REMOTE=gdrive:ChipsVoice
# STORAGE_RCLONE_LABEL=Google Drive
# --- Cloud sharing: ownCloud / Nextcloud ---
# OWNCLOUD_URL=https://cloud.example.com
# OWNCLOUD_USER=radio
# OWNCLOUD_PASSWORD=             # an app password, not the account password
# OWNCLOUD_FOLDER=ChipsVoice
# STORAGE_DEFAULT=owncloud       # used when a request names no target

# --- Sound effects: [sfx:name] tags in scripts (see docs/SETUP.md) ---
# SFX_DIR=/var/lib/chipsvoice/sfx   SFX_MAX_MB=5

# --- OpenRouter models: tone and conversation ---
# OPENROUTER_TTS_MODELS=openai/gpt-4o-mini-tts,google/gemini-2.5-flash-preview-tts   # allowed speech models
# OPENROUTER_TTS_DIALOGUE=emulate        # or native (unverified request shape)
# OPENROUTER_LLM_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku

# --- Chat control (Twilio WhatsApp/SMS, Telegram) and MCP ---
# CHAT_ALLOWED=whatsapp:+15551234567,telegram:123456789   # empty = nobody
# CHAT_CONFIRM=true                      # ask YES before anything goes on air
# TWILIO_AUTH_TOKEN=                     # with PUBLIC_URL; webhook is $PUBLIC_URL/chat/twilio
# TELEGRAM_BOT_TOKEN=  TELEGRAM_WEBHOOK_SECRET=
# MCP_READ_ONLY=false
# For the stdio MCP client: CHIPS_VOICE_URL=https://your-host  CHIPS_VOICE_KEY=<API_KEY>
